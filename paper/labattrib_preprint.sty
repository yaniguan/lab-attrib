% labattrib_preprint.sty — Focused Single-Topic Research Paper Template (Anthropic / OpenAI Style)
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{labattrib_preprint}[2026/11/23 Lab-Attrib Focused Preprint Style]

\RequirePackage[margin=0.95in, top=0.90in, bottom=0.96in, headheight=15pt]{geometry}
\RequirePackage{xcolor}
\RequirePackage{graphicx}
\RequirePackage{booktabs}
\RequirePackage{tabularx}
\RequirePackage{amsmath,amssymb,amsthm}
\RequirePackage{enumitem}
\RequirePackage{fancyhdr}
\RequirePackage{titlesec}
\RequirePackage{caption}
\RequirePackage[most]{tcolorbox}
\RequirePackage{listings}
\RequirePackage{hyperref}
\RequirePackage{mathpazo}

\linespread{1.09}
\setlength{\parindent}{0pt}
\setlength{\parskip}{5.2pt}

% Warm Ivory-Slate + Deep Indigo/Crimson Editorial Palette (distinct single-paper identity!)
\definecolor{ink}{HTML}{111827}
\definecolor{slate}{HTML}{374151}
\definecolor{muted}{HTML}{6B7280}
\definecolor{linegray}{HTML}{D1D5DB}
\definecolor{softbg}{HTML}{F9FAFB}
\definecolor{accent}{HTML}{1D4ED8}
\definecolor{accentdeep}{HTML}{1E3A8A}
\definecolor{tealok}{HTML}{0D9488}
\definecolor{crimson}{HTML}{BE123C}

\hypersetup{
  colorlinks=true,
  linkcolor=accentdeep,
  citecolor=accent,
  urlcolor=tealok,
  pdfauthor={Yani Guan},
  pdftitle={Proof-Carrying Negative Results: A Lean 4 Causal Blame Calculus and Precursor-Identifiability Guard for Self-Driving Laboratories}
}

\pagestyle{fancy}
\fancyhf{}
\renewcommand{\headrulewidth}{0.4pt}
\renewcommand{\headrule}{\hbox to\headwidth{\color{linegray}\leaders\hrule height \headrulewidth\hfill}}
\fancyhead[L]{\footnotesize\sffamily\textcolor{muted}{\textbf{lab-attrib} $\cdot$ Proof-Carrying Negative Results \& Causal Blame Calculus in Lean 4}}
\fancyhead[R]{\footnotesize\sffamily\textcolor{muted}{\thepage}}
\fancypagestyle{plain}{%
  \fancyhf{}%
  \renewcommand{\headrulewidth}{0pt}%
  \fancyfoot[C]{\footnotesize\sffamily\textcolor{muted}{\thepage}}%
}

\titleformat{\section}
  {\large\sffamily\bfseries\color{ink}}
  {\textcolor{accent}{\thesection}}
  {0.6em}
  {}
  [\vspace{-4pt}{\color{linegray}\titlerule[0.5pt]}]

\titleformat{\subsection}
  {\normalsize\sffamily\bfseries\color{ink}}
  {\textcolor{accent}{\thesubsection}}
  {0.55em}
  {}

\titlespacing*{\section}{0pt}{12pt}{5pt}
\titlespacing*{\subsection}{0pt}{8pt}{3pt}

\captionsetup{
  font={small},
  labelfont={bf,sf,color=ink},
  textfont={color=slate},
  skip=5pt
}

\newtcolorbox{formalbox}[2]{
  enhanced,
  breakable,
  colback=softbg,
  colframe=linegray,
  borderline west={2.8pt}{0pt}{accent},
  arc=3pt,
  boxrule=0.5pt,
  left=9pt, right=9pt, top=6pt, bottom=6pt,
  fonttitle=\small\sffamily\bfseries,
  coltitle=ink,
  colbacktitle=softbg,
  boxed title style={boxrule=0pt, colframe=softbg},
  attach title to upper={\par\vspace{2pt}},
  title={#1 \hfill \texttt{\footnotesize\textcolor{accent}{#2}}}
}

\newcommand{\makelabattribtitle}[5]{%
  \thispagestyle{plain}%
  \vspace*{-14pt}%
  \noindent{\color{accent}\rule{\textwidth}{2.4pt}}\par\vspace{3pt}%
  \noindent{\scriptsize\sffamily\bfseries\textcolor{accentdeep}{FOCUSED RESEARCH MONOGRAPH $\cdot$ EPISTEMIC RELIABILITY IN SELF-DRIVING LABORATORIES}\hfill\textcolor{muted}{NOVEMBER 2026 $\cdot$ LAB-ATTRIB}}\par\vspace{6pt}%
  {\LARGE\sffamily\bfseries\color{ink}\raggedright #1 \par}\vspace{4pt}%
  {\small\sffamily\color{slate}\raggedright #2 \par}\vspace{6pt}%
  \noindent{\small\sffamily\textbf{\textcolor{ink}{#3}} \;\;$\cdot$\;\; \textcolor{muted}{#4}}\par\vspace{2pt}%
  \noindent{\footnotesize\sffamily #5}\par\vspace{5pt}%
}
